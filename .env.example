# ════════════════════════════════════════════════════════════
#  SoLuna — .env namuna
#  Nusxa oling:  cp .env.example .env   so'ng qiymatlarni to'ldiring.
#  .env'ni hech qachon git'ga qo'ymang (maxfiy).
# ════════════════════════════════════════════════════════════

# ── Django asosiy ──
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Public HTTPS domen — to'lov return/webhook URL'lari shundan quriladi.
# Gateway serveringizga POST yuboradi, shuning uchun internetdan ochiq bo'lishi shart.
# Lokal test: ngrok http 8008  → bergan https URL'ini shu yerga qo'ying.
SITE_URL=http://localhost:8008

# ── Ma'lumotlar bazasi (bo'sh bo'lsa sqlite ishlatiladi) ──
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
REDIS_URL=redis://127.0.0.1:6379/0

# ════════════════════════════════════════════════════════════
#  TO'LOV GATEWAY'LARI
#  MUHIM: CLICK_MERCHANT_ID yoki PAYME_MERCHANT_ID'dan kamida bittasi
#  to'ldirilsa — REAL rejim yoqiladi. Ikkalasi ham bo'sh = MOCK (simulyatsiya).
# ════════════════════════════════════════════════════════════

# ── Click (https://merchant.click.uz → SHOP API) ──
# Webhook (Prepare/Complete) URL'ini Click kabinetiga qo'ying:
#   https://<SITE_URL>/payments/webhook/click/
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# ── Payme (https://business.payme.uz) ──
# Endpoint URL'ini Payme kabinetiga qo'ying:
#   https://<SITE_URL>/payments/webhook/payme/
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_KEY=

# ════════════════════════════════════════════════════════════
#  Tashqi xizmatlar (ixtiyoriy)
# ════════════════════════════════════════════════════════════

# ── Email (SMTP) ──
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SoLuna <no-reply@soluna.uz>

# ── Eskiz.uz SMS ──
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# ── Google OAuth (allauth) ──
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# ── Apple OAuth (allauth) ──
APPLE_CLIENT_ID=
APPLE_SECRET=
APPLE_KEY_ID=
APPLE_CERTIFICATE_KEY=

# ── Xaritalar / Monitoring ──
DGIS_API_KEY=
SENTRY_DSN=
